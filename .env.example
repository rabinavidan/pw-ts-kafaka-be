# API Configuration
API_BASE_URL=http://localhost:3000
API_KEY=your-api-key-here

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=playwright-test-client
KAFKA_GROUP_ID=playwright-test-group
KAFKA_CONNECTION_TIMEOUT=3000
KAFKA_REQUEST_TIMEOUT=30000

# Kafka SASL (optional)
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka SSL (optional)
KAFKA_SSL=false

# Test Configuration
TEST_TIMEOUT=60000
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Logging
LOG_LEVEL=info
